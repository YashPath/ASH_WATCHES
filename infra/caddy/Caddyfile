# Production edge: automatic HTTPS via Let's Encrypt. Set DOMAIN (and ACME_EMAIL) in .env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}

	# API goes straight to Express so rate limiting sees the real client IP (trust proxy = 1).
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /media-public/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
