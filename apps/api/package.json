{
  "name": "@ash/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate --schema=../../prisma/schema.prisma && tsc --noEmit -p tsconfig.json",
    "db:encrypt-totp-secrets": "tsx src/scripts/encrypt-existing-totp-secrets.ts",
    "search:reindex": "tsx src/scripts/reindex-search.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "create:admin": "tsx src/scripts/create-admin.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/cookie-parser": "^1.4.8",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "file-type": "^21.3.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.2",
    "rate-limit-redis": "^4.2.0",
    "ioredis": "^5.4.2",
    "bullmq": "^5.34.3",
    "otplib": "^12.0.1",
    "nodemailer": "^10.1.1",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "chromadb": "^3.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.0",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/nodemailer": "^8.0.2",
    "prisma": "5.22.0"
  }
}
