NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://ash:ash_dev_password@localhost:5432/ash_watch?schema=public
DIRECT_URL=postgresql://ash:ash_dev_password@localhost:5432/ash_watch?schema=public
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
STRIPE_PAYMENT_METHOD_TYPES=card
# Generate each independently with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
MEDIA_SIGNING_SECRET=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME
COOKIE_NAME=ash_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
HIBP_ENABLED=true
HIBP_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:6379
EMAIL_PROVIDER=console
EMAIL_FROM=ASH_ <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LOG_LEVEL=info
PRIVATE_MEDIA_DIR=./private-media
PUBLIC_MEDIA_DIR=./public-media
# Local public URLs use API_PUBLIC_URL/media-public; when set, MEDIA_PUBLIC_BASE_URL is the public bucket/CDN base URL and receives the key directly.
MEDIA_PUBLIC_BASE_URL=
MEDIA_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
TOTP_ISSUER=ASH_

# --- Search (ChromaDB + embeddings) ---
SEARCH_ENABLED=true
CHROMA_URL=http://localhost:8000
# Token checked by the nginx chroma-gateway (see infra/). Required in production when Chroma is not on localhost. Generate: openssl rand -hex 32
CHROMA_AUTH_TOKEN=
CHROMA_COLLECTION=ash_watches
CHROMA_TIMEOUT_MS=3000
# openai | ollama | hash. "hash" is offline and lexical only (not truly semantic). Must be set explicitly in production.
EMBEDDING_PROVIDER=hash
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Max paid query embeddings per hour (cost cap against abuse of the public search box)
EMBEDDING_HOURLY_BUDGET=2000
# Cosine distance above which a vector hit is ignored
SEMANTIC_MAX_DISTANCE=0.8

# --- Docker compose only ---
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Production (docker-compose.prod.yml)
DOMAIN=localhost
ACME_EMAIL=admin@example.com
